[build-system]
requires = ["setuptools>=61.0", "wheel"]
build-backend = "setuptools.build_meta"
[project]
name = "kaleidoscope-ai"
version = "0.1.0"
description = "Kaleidoscope AI - Software Ingestion, Analysis, and Mimicry System with Quantum-Inspired Elements"
readme = "README.md"
requires-python = ">=3.10"
license = { text = "LICENSE file not provided" }
authors = [ { name = "Your Name / Original Author", email = "your.email@example.com" }, ]
maintainers = [ { name = "Your Name / Original Author", email = "your.email@example.com" }, ]
classifiers = [
    "Development Status :: 3 - Alpha", "Intended Audience :: Developers", "Intended Audience :: Science/Research",
    "Programming Language :: Python :: 3", "Programming Language :: Python :: 3.10", "Programming Language :: Python :: 3.11",
    "Operating System :: OS Independent", "License :: OSI Approved :: MIT License", # Example
    "Topic :: Software Development :: Disassemblers", "Topic :: Software Development :: Compilers",
    "Topic :: Scientific/Engineering :: Artificial Intelligence", "Topic :: System :: Emulators",
]
keywords = ["reverse engineering", "decompilation", "binary analysis", "software mimicry", "llm", "ollama", "ghidra", "radare2", "ai", "quantum ai"]
dynamic = ["dependencies"]
[project.urls]
Homepage = "local"
Repository = "local"
Documentation = "local"
[project.scripts]
kaleidoscope = "main:main"
kaleidoscope-launcher = "scripts.launcher:main"
[project.gui-scripts]
qsin-viz = "visualization.qsin_visualizer:main"
[project.optional-dependencies]
viz = ["plotly>=5.0", "matplotlib>=3.5"]
viz-plotly = ["plotly>=5.0"]
viz-tkinter = ["matplotlib>=3.5"]
llamacpp = ["llama-cpp-python"]
dev = ["pytest", "ruff", "black", "isort", "mypy"]
test = ["pytest"]
lint = ["ruff", "black", "isort", "mypy"]
[tool.setuptools.dynamic]
dependencies = {file = ["requirements.txt"]}
[tool.setuptools.packages.find]
where = ["."]
include = ["core*", "llm*", "utils*", "sandbox*", "analysis*", "reconstruction*",
           "mimicry*", "interfaces*", "quantum*", "visualization*", "nodes*",
           "supernode*", "state*", "patterns*", "auth*", "error*", "web*", "licensing*"]
exclude = ["_unclassified*", "docs*", "scripts*", "tests*", "data*", ".venv*"]
[tool.setuptools.package-data]
web = ["templates/*", "templates/*/*", "static/*", "static/*/*"]
[tool.black]
line-length = 88
target-version = ['py310']
[tool.isort]
profile = "black"
line_length = 88
[tool.ruff]
line-length = 88
select = ["E", "W", "F", "I", "C", "B"]
ignore = ["E501"]
target-version = "py310"
[tool.mypy]
python_version = "3.10"
warn_return_any = true
warn_unused_configs = true
